<!-- Landing Page - GuiriGestor Finance Automation -->
<style>
  /* Custom fonts - Using distinctive typography */
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Sora:wght@300;400;500;600;700&display=swap');
  
  :root {
    --landing-bg: #0a0a0b;
    --landing-surface: #141416;
    --landing-surface-light: #1c1c1f;
    --landing-border: rgba(255,255,255,0.08);
    --landing-text: #ffffff;
    --landing-text-muted: #8b8b8d;
    --landing-accent: #10b981;
    --landing-accent-light: #34d399;
    --landing-accent-glow: rgba(16, 185, 129, 0.15);
    --landing-gradient-1: #10b981;
    --landing-gradient-2: #06b6d4;
    --font-display: 'Instrument Serif', Georgia, serif;
    --font-body: 'Sora', system-ui, sans-serif;
  }
  
  .landing-page {
    font-family: var(--font-body);
    background: var(--landing-bg);
    color: var(--landing-text);
    overflow-x: hidden;
  }
  
  .landing-page * {
    box-sizing: border-box;
  }
  
  /* Typography */
  .landing-headline {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  
  .landing-subhead {
    font-family: var(--font-body);
    font-weight: 300;
    line-height: 1.6;
    color: var(--landing-text-muted);
  }
  
  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  
  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  
  @keyframes gradientMove {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  
  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }
  
  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
    opacity: 0;
  }
  
  .animate-slide-left {
    animation: slideInLeft 0.8s ease-out forwards;
    opacity: 0;
  }
  
  .animate-slide-right {
    animation: slideInRight 0.8s ease-out forwards;
    opacity: 0;
  }
  
  .animate-scale-in {
    animation: scaleIn 0.6s ease-out forwards;
    opacity: 0;
  }
  
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
  .delay-300 { animation-delay: 0.3s; }
  .delay-400 { animation-delay: 0.4s; }
  .delay-500 { animation-delay: 0.5s; }
  .delay-600 { animation-delay: 0.6s; }
  .delay-700 { animation-delay: 0.7s; }
  .delay-800 { animation-delay: 0.8s; }
  
  /* Scroll reveal */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .scroll-reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  
  .scroll-reveal-left {
    opacity: 0;
    transform: translateX(-30px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .scroll-reveal-left.revealed {
    opacity: 1;
    transform: translateX(0);
  }
  
  .scroll-reveal-right {
    opacity: 0;
    transform: translateX(30px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .scroll-reveal-right.revealed {
    opacity: 1;
    transform: translateX(0);
  }
  
  /* Hero Background */
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  
  .hero-gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
  }
  
  .hero-gradient-orb-1 {
    width: 600px;
    height: 600px;
    background: var(--landing-gradient-1);
    top: -200px;
    right: -100px;
    animation: float 8s ease-in-out infinite;
  }
  
  .hero-gradient-orb-2 {
    width: 400px;
    height: 400px;
    background: var(--landing-gradient-2);
    bottom: -100px;
    left: -100px;
    animation: float 10s ease-in-out infinite reverse;
  }
  
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 70%, transparent 100%);
  }
  
  /* Buttons */
  .landing-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: linear-gradient(135deg, var(--landing-gradient-1), var(--landing-gradient-2));
    background-size: 200% 200%;
    color: white;
    font-weight: 600;
    font-size: 16px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    animation: gradientMove 4s ease infinite;
  }
  
  .landing-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px rgba(16, 185, 129, 0.3);
  }
  
  .landing-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: transparent;
    color: var(--landing-text);
    font-weight: 500;
    font-size: 15px;
    border-radius: 12px;
    border: 1px solid var(--landing-border);
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
  }
  
  .landing-btn-secondary:hover {
    background: var(--landing-surface);
    border-color: var(--landing-accent);
  }
  
  /* Cards */
  .landing-card {
    background: var(--landing-surface);
    border: 1px solid var(--landing-border);
    border-radius: 16px;
    padding: 32px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .landing-card:hover {
    border-color: rgba(16, 185, 129, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }
  
  /* Feature icon */
  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--landing-accent-glow);
    border-radius: 12px;
    margin-bottom: 20px;
  }
  
  .feature-icon svg {
    width: 24px;
    height: 24px;
    color: var(--landing-accent);
  }
  
  /* Pricing cards */
  .pricing-card {
    background: var(--landing-surface);
    border: 1px solid var(--landing-border);
    border-radius: 20px;
    padding: 40px;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }
  
  .pricing-card.featured {
    border-color: var(--landing-accent);
    background: linear-gradient(180deg, var(--landing-surface) 0%, rgba(16, 185, 129, 0.05) 100%);
  }
  
  .pricing-card.featured::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--landing-gradient-1), var(--landing-gradient-2));
  }
  
  .pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.4);
  }
  
  /* FAQ Accordion */
  .faq-item {
    border-bottom: 1px solid var(--landing-border);
  }
  
  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    cursor: pointer;
    font-weight: 500;
    font-size: 18px;
    transition: color 0.3s ease;
  }
  
  .faq-question:hover {
    color: var(--landing-accent);
  }
  
  .faq-icon {
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
  }
  
  .faq-item.open .faq-icon {
    transform: rotate(45deg);
  }
  
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
    color: var(--landing-text-muted);
    line-height: 1.7;
  }
  
  .faq-item.open .faq-answer {
    max-height: 300px;
    padding-bottom: 24px;
  }
  
  /* Pain points */
  .pain-point {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--landing-border);
  }
  
  .pain-point:last-child {
    border-bottom: none;
  }
  
  .pain-icon {
    width: 24px;
    height: 24px;
    color: #ef4444;
    flex-shrink: 0;
    margin-top: 2px;
  }
  
  /* Solution checkmarks */
  .solution-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 32px;
  }
  
  .solution-check {
    width: 28px;
    height: 28px;
    background: var(--landing-accent-glow);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .solution-check svg {
    width: 16px;
    height: 16px;
    color: var(--landing-accent);
  }
  
  /* Testimonials */
  .testimonial-card {
    background: var(--landing-surface);
    border: 1px solid var(--landing-border);
    border-radius: 16px;
    padding: 32px;
    position: relative;
  }
  
  .testimonial-quote {
    position: absolute;
    top: 24px;
    left: 28px;
    font-size: 48px;
    color: var(--landing-accent);
    opacity: 0.3;
    font-family: var(--font-display);
    line-height: 1;
  }
  
  /* Navigation */
  .landing-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    backdrop-filter: blur(20px);
    background: rgba(10, 10, 11, 0.8);
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
  }
  
  .landing-nav.scrolled {
    border-bottom-color: var(--landing-border);
    padding: 16px 40px;
  }
  
  .landing-logo {
    font-family: var(--font-display);
    font-size: 24px;
    font-style: italic;
    color: var(--landing-text);
    text-decoration: none;
  }
  
  .landing-nav-links {
    display: flex;
    gap: 32px;
    align-items: center;
  }
  
  .landing-nav-link {
    color: var(--landing-text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.3s ease;
  }
  
  .landing-nav-link:hover {
    color: var(--landing-text);
  }
  
  /* Section container */
  .landing-section {
    padding: 120px 40px;
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .landing-section-header {
    text-align: center;
    margin-bottom: 80px;
  }
  
  /* Pricing list */
  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 32px 0;
  }
  
  .pricing-features li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    color: var(--landing-text-muted);
    font-size: 15px;
  }
  
  .pricing-features li svg {
    width: 18px;
    height: 18px;
    color: var(--landing-accent);
    flex-shrink: 0;
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .landing-section {
      padding: 80px 20px;
    }
    
    .landing-nav {
      padding: 16px 20px;
    }
    
    .landing-nav-links {
      display: none;
    }
    
    .hero-gradient-orb-1 {
      width: 300px;
      height: 300px;
    }
    
    .hero-gradient-orb-2 {
      width: 200px;
      height: 200px;
    }
  }
  
  /* Feature tabs */
  .feature-tab {
    padding: 24px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }
  
  .feature-tab:hover {
    background: var(--landing-surface);
  }
  
  .feature-tab.active {
    background: var(--landing-surface);
    border-color: var(--landing-accent);
  }
  
  /* Badge */
  .landing-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--landing-accent-glow);
    color: var(--landing-accent);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 24px;
  }
  
  /* Animated border */
  .animated-border {
    position: relative;
    background: var(--landing-surface);
    border-radius: 16px;
  }
  
  .animated-border::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(90deg, var(--landing-gradient-1), var(--landing-gradient-2), var(--landing-gradient-1));
    background-size: 200% 100%;
    border-radius: 18px;
    z-index: -1;
    animation: shimmer 3s linear infinite;
  }
</style>

<div class="landing-page">
  <!-- Navigation -->
  <nav class="landing-nav" id="landing-nav">
    <a href="#" class="landing-logo">GuiriGestor</a>
    <div class="landing-nav-links">
      <a href="#features" class="landing-nav-link">Features</a>
      <a href="#pricing" class="landing-nav-link">Pricing</a>
      <a href="#faq" class="landing-nav-link">FAQ</a>
      <a href="<%= new_user_session_path %>" class="landing-btn-secondary" style="padding: 10px 20px; font-size: 14px;">
        Log in
      </a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center" style="padding-top: 100px;">
    <div class="hero-bg">
      <div class="hero-gradient-orb hero-gradient-orb-1"></div>
      <div class="hero-gradient-orb hero-gradient-orb-2"></div>
      <div class="hero-grid"></div>
    </div>
    
    <div class="relative z-10 text-center px-5" style="max-width: 900px;">
      <div class="landing-badge animate-fade-in">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Built by a freelancer, for freelancers
      </div>
      
      <h1 class="landing-headline animate-fade-in-up delay-100" style="font-size: clamp(3rem, 8vw, 5.5rem); margin-bottom: 24px;">
        Your freelancer finances —<br>
        <span style="font-style: italic; background: linear-gradient(135deg, var(--landing-gradient-1), var(--landing-gradient-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">fully automated.</span>
      </h1>
      
      <p class="landing-subhead animate-fade-in-up delay-200" style="font-size: 20px; max-width: 700px; margin: 0 auto 48px;">
        Invoices, autónomo payments, receipts, and quarterly reports — all in one place. Upload anything. AI extracts everything. Your accountant gets a clean, organized portal every quarter.
      </p>
      
      <div class="flex flex-wrap justify-center gap-4 animate-fade-in-up delay-300">
        <a href="#" class="landing-btn-primary">
          Start Free
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="#features" class="landing-btn-secondary">
          See how it works
        </a>
      </div>
      
      <p class="animate-fade-in delay-400" style="margin-top: 20px; font-size: 14px; color: var(--landing-text-muted);">
        No credit card required
      </p>
      
      <!-- Social proof -->
      <div class="animate-fade-in-up delay-500" style="margin-top: 80px; padding: 24px 32px; background: var(--landing-surface); border: 1px solid var(--landing-border); border-radius: 16px; display: inline-block;">
        <p style="font-style: italic; color: var(--landing-text); font-size: 16px; margin-bottom: 8px;">
          "Saves me 6–8 hours every month. Finally, everything is in one place."
        </p>
        <p style="font-size: 13px; color: var(--landing-text-muted);">
          — Sarah M., Freelance Developer, Beta User
        </p>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="landing-section" style="background: var(--landing-surface);">
    <div class="landing-section-header scroll-reveal">
      <h2 class="landing-headline" style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 20px;">
        Being a freelancer shouldn't mean <span style="font-style: italic; color: var(--landing-accent);">this</span>
      </h2>
      <p class="landing-subhead" style="font-size: 18px;">
        Sound familiar? You're not alone.
      </p>
    </div>
    
    <div style="max-width: 700px; margin: 0 auto;">
      <div class="pain-point scroll-reveal" style="transition-delay: 0.1s;">
        <svg class="pain-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        <div>
          <p style="font-size: 17px; font-weight: 500; margin-bottom: 4px;">Forgetting to send invoices to your accountant</p>
          <p style="font-size: 14px; color: var(--landing-text-muted);">Until they chase you at the last minute before a deadline</p>
        </div>
      </div>
      
      <div class="pain-point scroll-reveal" style="transition-delay: 0.15s;">
        <svg class="pain-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        <div>
          <p style="font-size: 17px; font-weight: 500; margin-bottom: 4px;">Digging through emails for monthly autónomo payments</p>
          <p style="font-size: 14px; color: var(--landing-text-muted);">Where did that PDF go again?</p>
        </div>
      </div>
      
      <div class="pain-point scroll-reveal" style="transition-delay: 0.2s;">
        <svg class="pain-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        <div>
          <p style="font-size: 17px; font-weight: 500; margin-bottom: 4px;">Downloading receipts from 15 different services</p>
          <p style="font-size: 14px; color: var(--landing-text-muted);">ChatGPT, Canva, Notion, Figma, hosting, domains...</p>
        </div>
      </div>
      
      <div class="pain-point scroll-reveal" style="transition-delay: 0.25s;">
        <svg class="pain-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        <div>
          <p style="font-size: 17px; font-weight: 500; margin-bottom: 4px;">Manually typing totals into spreadsheets</p>
          <p style="font-size: 14px; color: var(--landing-text-muted);">And hoping you didn't make any errors</p>
        </div>
      </div>
      
      <div class="pain-point scroll-reveal" style="transition-delay: 0.3s;">
        <svg class="pain-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        <div>
          <p style="font-size: 17px; font-weight: 500; margin-bottom: 4px;">Juggling 5+ tools just to stay compliant</p>
          <p style="font-size: 14px; color: var(--landing-text-muted);">Spreadsheets, email, cloud storage, invoice software, banking...</p>
        </div>
      </div>
      
      <div class="scroll-reveal" style="text-align: center; margin-top: 48px; padding: 32px; background: rgba(239, 68, 68, 0.1); border-radius: 16px; border: 1px solid rgba(239, 68, 68, 0.2); transition-delay: 0.35s;">
        <p style="font-size: 18px; font-weight: 500; color: #fca5a5;">
          It's exhausting, error-prone, and wastes hours every month.
        </p>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section id="features" class="landing-section">
    <div class="landing-section-header scroll-reveal">
      <div class="landing-badge">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        The Solution
      </div>
      <h2 class="landing-headline" style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 20px;">
        Meet the automated finance hub<br>
        <span style="font-style: italic;">for freelancers</span>
      </h2>
      <p class="landing-subhead" style="font-size: 18px; max-width: 600px; margin: 0 auto;">
        Everything you need to stay organised, compliant, and connected to your accountant.
      </p>
