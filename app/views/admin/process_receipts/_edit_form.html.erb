<div style="max-width: 600px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h3 style="margin: 0; font-size: 1.3rem; font-weight: 600;">
      Edit Receipt #<%= @receipt.id %>
    </h3>
    <% if @receipt.notes.present? && @receipt.notes.start_with?('[AI:') %>
      <% confidence = @receipt.notes.match(/\[AI: (\w+)\]/)[1] rescue 'unknown' %>
      <span style="
        padding: 0.25rem 0.75rem; 
        border-radius: 12px; 
        font-size: 0.75rem; 
        font-weight: 600;
        <%= case confidence
            when 'high' then 'background: #d4edda; color: #155724;'
            when 'medium' then 'background: #fff3cd; color: #856404;'
            when 'low' then 'background: #f8d7da; color: #721c24;'
            else 'background: #e2e3e5; color: #383d41;'
            end %>
      ">
        🤖 AI: <%= confidence.upcase %>
      </span>
    <% end %>
  </div>

  <% if defined?(@errors) && @errors.present? %>
    <div style="background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem;">
      <strong>Errors:</strong>
      <ul style="margin: 0.5rem 0 0 1.25rem; padding: 0;">
        <% @errors.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <form id="receipt-form-<%= @receipt.id %>"
        hx-post="/admin/process_receipts/<%= @receipt.id %>/update" 
        hx-target="#edit-form-container"
        hx-swap="innerHTML">
    
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <div class="form-group">
      <label for="fiscal_quarter_id">Fiscal Quarter *</label>
      <select name="outgoing_receipt[fiscal_quarter_id]" id="fiscal_quarter_id">
        <option value="">Select Fiscal Quarter</option>
        <% FiscalQuarter.order(created_at: :desc).each do |fq| %>
          <option value="<%= fq.id %>" <%= 'selected' if @receipt.fiscal_quarter_id == fq.id %>>
            <%= fq.name %> - <%= fq.user.email %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="form-group">
      <label for="service_id">
        Service *
        <% if @receipt.service_id.present? && @receipt.notes.to_s.include?('[AI:') %>
          <span style="font-size: 0.7rem; color: #5b9bd5; font-weight: normal;">✨ AI suggested</span>
        <% end %>
      </label>
      <select name="outgoing_receipt[service_id]" id="service_id">
        <option value="">Select Service</option>
        <% Service.where(active: true).order(:name).each do |service| %>
          <option value="<%= service.id %>" 
                  data-amount="<%= service.amount %>" 
                  data-currency="<%= service.currency %>"
                  <%= 'selected' if @receipt.service_id == service.id %>>
            <%= service.name %>
          </option>
        <% end %>
      </select>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="form-group">
        <label for="month">Month *</label>
        <select name="outgoing_receipt[month]" id="month">
          <option value="">Select Month</option>
          <% (1..12).each do |m| %>
            <option value="<%= m %>" <%= 'selected' if @receipt.month == m %>>
              <%= Date::MONTHNAMES[m] %>
            </option>
          <% end %>
        </select>
      </div>

      <div class="form-group">
        <label for="year">Year *</label>
        <input type="number" name="outgoing_receipt[year]" id="year" 
               value="<%= @receipt.year || Date.current.year %>" 
               placeholder="2025">
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
      <div class="form-group">
        <label for="amount">Amount *</label>
        <input type="number" step="0.01" name="outgoing_receipt[amount]" id="amount" 
               value="<%= @receipt.amount %>" 
               placeholder="0.00">
      </div>

      <div class="form-group">
        <label for="currency">Currency *</label>
        <select name="outgoing_receipt[currency]" id="currency">
          <option value="EUR" <%= 'selected' if @receipt.currency == 'EUR' %>>EUR (€)</option>
          <option value="USD" <%= 'selected' if @receipt.currency == 'USD' %>>USD ($)</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="status">Status *</label>
      <select name="outgoing_receipt[status]" id="status">
        <option value="">Select Status</option>
        <% OutgoingReceipt.statuses.keys.each do |status_key| %>
          <option value="<%= status_key %>" <%= 'selected' if @receipt.status == status_key %>>
            <%= status_key.titleize %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="form-group">
      <label for="notes">Notes</label>
      <textarea name="outgoing_receipt[notes]" id="notes" rows="3" 
                placeholder="Add any notes about this receipt..."><%= @receipt.notes.to_s.gsub(/\A\s*\[AI:\s*[^\]]+\]\s*/, '') %></textarea>
    </div>

    <div style="display: flex; gap: 0.5rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #e0e0e0;">
      <button type="submit" class="save-btn">
        Save Changes
      </button>
      <button type="button" class="mark-assigned-btn" onclick="markAsAssigned(<%= @receipt.id %>)">
        Mark as Assigned & Next
      </button>
    </div>
  </form>

  <script>
    // Auto-fill amount and currency when service is selected
    // BUT only if amount field is empty (don't override AI-extracted amounts)
    document.getElementById('service_id').addEventListener('change', function(e) {
      const selectedOption = e.target.options[e.target.selectedIndex];
      const amount = selectedOption.dataset.amount;
      const currency = selectedOption.dataset.currency;
      
      const amountField = document.getElementById('amount');
      const currencyField = document.getElementById('currency');
      
      // Only auto-fill if the amount field is empty or zero
      if (amount && (!amountField.value || parseFloat(amountField.value) === 0)) {
        amountField.value = amount;
      }
      
      // Only auto-fill currency if it's not already set
      if (currency && !currencyField.value) {
        currencyField.value = currency;
      }
    });
  </script>
</div>

