<% unassigned_receipts = OutgoingReceipt.where(assigned: false).order(created_at: :desc) %>

<div style="padding: 0;">
  <% if unassigned_receipts.empty? %>
    <div style="padding: 3rem; text-align: center; color: #666;">
      <h3>No Unassigned Receipts</h3>
      <p>All receipts have been processed!</p>
    </div>
  <% else %>
    <div style="display: flex; height: calc(100vh - 120px); overflow: hidden;">
      
      <!-- Left Side: PDF Preview -->
      <div style="flex: 1; background: #f5f5f5; overflow-y: auto; border-right: 2px solid #ddd;">
        <div id="pdf-preview-container" style="padding: 2rem;">
          <div id="pdf-loading" style="text-align: center; padding: 3rem; color: #999;">
            <p style="font-size: 1.2rem;">← Select a receipt to preview</p>
          </div>
          <iframe id="pdf-viewer" style="width: 100%; height: 80vh; border: none; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); display: none;"></iframe>
        </div>
      </div>

      <!-- Right Side: Receipts List & Edit Form -->
      <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
        
        <!-- Receipts List -->
        <div style="flex: 0 0 auto; max-height: 40%; overflow-y: auto; border-bottom: 2px solid #ddd; background: white;">
          <div style="padding: 1.5rem; background: #f9f9f9; border-bottom: 1px solid #e0e0e0; position: sticky; top: 0; z-index: 10;">
            <h3 style="margin: 0; font-size: 1.2rem; font-weight: 600;">
              Unassigned Receipts (<span class="receipts-count"><%= unassigned_receipts.count %></span>)
            </h3>
          </div>
          
          <div id="receipts-list">
            <% unassigned_receipts.each_with_index do |receipt, index| %>
              <div class="receipt-item <%= 'active' if index == 0 %>" 
                   data-receipt-id="<%= receipt.id %>"
                   onclick="loadReceipt(<%= receipt.id %>)"
                   style="
                     padding: 1rem 1.5rem;
                     border-bottom: 1px solid #e0e0e0;
                     cursor: pointer;
                     transition: all 0.2s ease;
                   ">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <div>
                    <div style="font-weight: 600; margin-bottom: 0.25rem;">
                      Receipt #<%= receipt.id %>
                    </div>
                    <div style="font-size: 0.875rem; color: #666;">
                      <% if receipt.receipt_file.attached? %>
                        <%= receipt.receipt_file.filename %>
                      <% else %>
                        No file attached
                      <% end %>
                    </div>
                  </div>
                  <div style="width: 8px; height: 8px; background: #5b9bd5; border-radius: 50%; opacity: 0;" class="active-indicator"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Edit Form Area -->
        <div style="flex: 1; overflow-y: auto; background: white;">
          <div id="edit-form-container" style="padding: 2rem;">
            <div style="text-align: center; padding: 3rem; color: #999;">
              <p>Select a receipt to edit</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <style>
      .receipt-item:hover {
        background: #f0f0f0;
      }

      .receipt-item.active {
        background: #e8f4f8;
        border-left: 4px solid #5b9bd5;
      }

      .receipt-item.active .active-indicator {
        opacity: 1 !important;
      }

      .form-group {
        margin-bottom: 1.5rem;
      }

      .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #333;
        font-size: 0.875rem;
      }

      .form-group input,
      .form-group select,
      .form-group textarea {
        width: 100%;
        padding: 0.625rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 0.875rem;
      }

      .form-group input:focus,
      .form-group select:focus,
      .form-group textarea:focus {
        outline: none;
        border-color: #5b9bd5;
        box-shadow: 0 0 0 3px rgba(91, 155, 213, 0.1);
      }

      .save-btn {
        background: #5b9bd5;
        color: white;
        padding: 0.75rem 2rem;
        border: none;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .save-btn:hover {
        background: #4a8bc2;
      }

      .mark-assigned-btn {
        background: #28a745;
        color: white;
        padding: 0.75rem 2rem;
        border: none;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-left: 0.5rem;
      }

      .mark-assigned-btn:hover {
        background: #218838;
      }
    </style>

    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script>
      let currentReceiptId = null;

      // Load first receipt on page load
      document.addEventListener('DOMContentLoaded', function() {
        <% if unassigned_receipts.first %>
          loadReceipt(<%= unassigned_receipts.first.id %>);
        <% end %>
      });

      function loadReceipt(receiptId) {
        currentReceiptId = receiptId;
        
        // Update active state in list
        document.querySelectorAll('.receipt-item').forEach(item => {
          item.classList.remove('active');
        });
        document.querySelector(`.receipt-item[data-receipt-id="${receiptId}"]`).classList.add('active');

        // Load PDF preview
        fetch(`/admin/process_receipts/${receiptId}/preview`)
          .then(response => response.text())
          .then(url => {
            document.getElementById('pdf-loading').style.display = 'none';
            const viewer = document.getElementById('pdf-viewer');
            viewer.src = url;
            viewer.style.display = 'block';
          });

        // Load edit form via HTMX
        htmx.ajax('GET', `/admin/process_receipts/${receiptId}/edit`, {
          target: '#edit-form-container',
          swap: 'innerHTML'
        });
      }

      function markAsAssigned(receiptId) {
        if (confirm('Save changes, mark as assigned, and move to next receipt?')) {
          // Get form data
          const form = document.getElementById(`receipt-form-${receiptId}`);
          const formData = new FormData(form);
          
          // Send form data along with mark_assigned request
          fetch(`/admin/process_receipts/${receiptId}/mark_assigned`, {
            method: 'POST',
            headers: {
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: formData
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              // Remove from list
              const item = document.querySelector(`.receipt-item[data-receipt-id="${receiptId}"]`);
              item.remove();
              
              // Update count
              const countElement = document.querySelector('.receipts-count');
              if (countElement) {
                const currentCount = parseInt(countElement.textContent);
                countElement.textContent = currentCount - 1;
              }
              
              // Load next receipt
              const nextItem = document.querySelector('.receipt-item');
              if (nextItem) {
                loadReceipt(nextItem.dataset.receiptId);
              } else {
                // No more receipts
                location.reload();
              }
            } else {
              // Show errors
              const errorHtml = `
                <div style="background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem;">
                  <strong>Cannot mark as assigned:</strong>
                  <ul style="margin: 0.5rem 0 0 1.25rem; padding: 0;">
                    ${data.errors.map(err => `<li>${err}</li>`).join('')}
                  </ul>
                </div>
              `;
              document.getElementById('edit-form-container').insertAdjacentHTML('afterbegin', errorHtml);
              
              // Remove error after 5 seconds
              setTimeout(() => {
                const errorDiv = document.querySelector('#edit-form-container > div:first-child');
                if (errorDiv && errorDiv.style.background === 'rgb(248, 215, 218)') {
                  errorDiv.remove();
                }
              }, 5000);
            }
          })
          .catch(error => {
            alert('An error occurred. Please try again.');
            console.error('Error:', error);
          });
        }
      }

      // Listen for successful HTMX form submission
      document.body.addEventListener('htmx:afterRequest', function(event) {
        if (event.detail.successful && event.detail.xhr.status === 200) {
          // Show success message briefly
          const formContainer = document.getElementById('edit-form-container');
          const successMsg = document.createElement('div');
          successMsg.style.cssText = 'position: fixed; top: 20px; right: 20px; background: #28a745; color: white; padding: 1rem 1.5rem; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.2); z-index: 1000;';
          successMsg.textContent = '✓ Saved successfully';
          document.body.appendChild(successMsg);
          
          setTimeout(() => {
            successMsg.remove();
          }, 2000);
        }
      });
    </script>
  <% end %>
</div>

