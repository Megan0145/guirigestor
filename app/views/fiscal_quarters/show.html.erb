<!-- Passcode Modal -->
<div id="passcode-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" style="display: none;">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3 text-center">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 mb-4">
        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
      </div>
      <h3 class="text-lg leading-6 font-medium text-gray-900 mb-2">Enter Passcode</h3>
      <p class="text-sm text-gray-500 mb-4">Please enter the passcode to access this fiscal quarter.</p>
      
      <form id="passcode-form" class="mt-4">
        <div class="mb-4">
          <input type="password" id="passcode-input" placeholder="Enter passcode" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
        </div>
        <div id="error-message" class="text-red-600 text-sm mb-4" style="display: none;"></div>
        <div class="flex justify-center space-x-3">
          <button type="submit" id="verify-btn" 
                  class="px-4 py-2 bg-blue-600 text-white text-base font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors">
            <span class="verify-text">Verify</span>
            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white loading-spinner" style="display: none;" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Main Content -->
<div id="auth-content" class="min-h-screen bg-gray-50 py-8" style="display: none;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @fiscal_quarter.name %></h1>
          <p class="text-gray-600 mt-1">
            <%= @fiscal_quarter.start_date.strftime("%B %d, %Y") %> - 
            <%= @fiscal_quarter.end_date.strftime("%B %d, %Y") %>
          </p>
        </div>
        <div class="flex items-center space-x-4">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @fiscal_quarter.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
            <%= @fiscal_quarter.status.titleize %>
          </span>
          <span class="text-sm text-gray-500">ID: <%= @fiscal_quarter.identifier %></span>
        </div>
      </div>
      <% if @fiscal_quarter.notes.present? %>
        <div class="mt-4 p-4 bg-blue-50 rounded-lg">
          <p class="text-blue-800"><%= simple_format(@fiscal_quarter.notes) %></p>
        </div>
      <% end %>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center">
          <div class="p-2 bg-blue-100 rounded-lg">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Invoices</p>
            <p class="text-2xl font-bold text-gray-900"><%= @invoices.count %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center">
          <div class="p-2 bg-green-100 rounded-lg">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Autonomo Payments</p>
            <p class="text-2xl font-bold text-gray-900"><%= @autonomo_payments.count %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center">
          <div class="p-2 bg-purple-100 rounded-lg">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Outgoing Receipts</p>
            <p class="text-2xl font-bold text-gray-900"><%= @outgoing_receipts.count %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Invoices Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900">Invoices</h2>
      </div>
      <div class="overflow-x-auto">
        <% if @invoices.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice #</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recipient</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Issued</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Due</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Items</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @invoices.each do |invoice| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">#<%= invoice.invoice_number %></div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900"><%= invoice.recipient_company_name %></div>
                    <div class="text-sm text-gray-500"><%= invoice.recipient_email %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-semibold text-gray-900">
                      <%= number_to_currency(invoice.total_amount, unit: invoice.currency == 'EUR' ? '€' : '$') %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= invoice.issued_on&.strftime("%b %d, %Y") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= invoice.due_on&.strftime("%b %d, %Y") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      <%= invoice.invoice_line_items.count %> items
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-6 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No invoices</h3>
            <p class="mt-1 text-sm text-gray-500">No invoices have been created for this fiscal quarter yet.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Autonomo Payments Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900">Autonomo Payments</h2>
      </div>
      <div class="overflow-x-auto">
        <% if @autonomo_payments.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Uploaded</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Notes</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">File</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @autonomo_payments.each do |payment| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                      <%= case payment.status
                          when 'paid' then 'bg-green-100 text-green-800'
                          when 'pending' then 'bg-yellow-100 text-yellow-800'
                          when 'rejected' then 'bg-red-100 text-red-800'
                          else 'bg-gray-100 text-gray-800'
                          end %>">
                      <%= payment.status.titleize %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= payment.uploaded_on&.strftime("%b %d, %Y at %I:%M %p") %>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900 max-w-xs truncate">
                      <%= payment.notes.present? ? payment.notes : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if payment.payment_file.attached? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                        File attached
                      </span>
                    <% else %>
                      <span class="text-sm text-gray-400">No file</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-6 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No autonomo payments</h3>
            <p class="mt-1 text-sm text-gray-500">No autonomo payments have been recorded for this fiscal quarter yet.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Outgoing Receipts Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900">Outgoing Receipts</h2>
      </div>
      <div class="overflow-x-auto">
        <% if @outgoing_receipts.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Uploaded</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Notes</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">File</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @outgoing_receipts.each do |receipt| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                      <%= case receipt.status
                          when 'paid' then 'bg-green-100 text-green-800'
                          when 'pending' then 'bg-yellow-100 text-yellow-800'
                          when 'rejected' then 'bg-red-100 text-red-800'
                          else 'bg-gray-100 text-gray-800'
                          end %>">
                      <%= receipt.status.titleize %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= receipt.uploaded_on&.strftime("%b %d, %Y at %I:%M %p") %>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900 max-w-xs truncate">
                      <%= receipt.notes.present? ? receipt.notes : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if receipt.receipt_file.attached? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                        File attached
                      </span>
                    <% else %>
                      <span class="text-sm text-gray-400">No file</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-6 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No outgoing receipts</h3>
            <p class="mt-1 text-sm text-gray-500">No outgoing receipts have been recorded for this fiscal quarter yet.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const fiscalQuarterId = '<%= @fiscal_quarter.identifier %>';
  const storageKey = `fiscal_quarter_access_${fiscalQuarterId}`;
  const passcodeModal = document.getElementById('passcode-modal');
  const mainContent = document.getElementById('auth-content');
  const passcodeForm = document.getElementById('passcode-form');
  const passcodeInput = document.getElementById('passcode-input');
  const errorMessage = document.getElementById('error-message');
  const verifyBtn = document.getElementById('verify-btn');
  const verifyText = verifyBtn.querySelector('.verify-text');
  const loadingSpinner = verifyBtn.querySelector('.loading-spinner');

  // Check if user has access
  function checkAccess() {
    const hasAccess = localStorage.getItem(storageKey);
    if (hasAccess === 'granted') {
      showMainContent();
    } else {
      showPasscodeModal();
    }
  }

  function showMainContent() {
    passcodeModal.style.display = 'none';
    mainContent.style.display = 'block';
  }

  function showPasscodeModal() {
    console.log('Showing passcode modal');
    console.log('Showing passcode modal');
    console.log(passcodeModal);
    console.log(mainContent);
    passcodeModal.style.display = 'block';
    mainContent.style.display = 'none';
    passcodeInput.focus();
  }

  function showError(message) {
    errorMessage.textContent = message;
    errorMessage.style.display = 'block';
    passcodeInput.classList.add('border-red-500');
  }

  function hideError() {
    errorMessage.style.display = 'none';
    passcodeInput.classList.remove('border-red-500');
  }

  function setLoading(loading) {
    if (loading) {
      verifyBtn.disabled = true;
      verifyText.style.display = 'none';
      loadingSpinner.style.display = 'inline-block';
    } else {
      verifyBtn.disabled = false;
      verifyText.style.display = 'inline';
      loadingSpinner.style.display = 'none';
    }
  }

  // Handle form submission
  passcodeForm.addEventListener('submit', function(e) {
    e.preventDefault();
    hideError();
    
    const passcode = passcodeInput.value.trim();
    if (!passcode) {
      showError('Please enter a passcode');
      return;
    }

    setLoading(true);

    // Verify passcode with server
    fetch(`/<%= @fiscal_quarter.identifier %>/verify-passcode`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ passcode: passcode })
    })
    .then(response => response.json())
    .then(data => {
      setLoading(false);
      
      if (data.success) {
        // Store access in localStorage
        localStorage.setItem(storageKey, 'granted');
        showMainContent();
      } else {
        showError('Invalid passcode. Please try again.');
        passcodeInput.value = '';
        passcodeInput.focus();
      }
    })
    .catch(error => {
      setLoading(false);
      showError('An error occurred. Please try again.');
      console.error('Error:', error);
    });
  });

  // Allow Enter key to submit
  passcodeInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      passcodeForm.dispatchEvent(new Event('submit'));
    }
  });

  // Initialize
  checkAccess();
});
</script>
