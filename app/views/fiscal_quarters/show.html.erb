<!-- Passcode Modal -->
<div id="passcode-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" style="display: none;">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <!-- Language Selector in Modal -->
    <div class="flex justify-end mb-4">
      <div class="relative inline-block">
        <select id="modal-language-selector" onchange="changeLanguage(this.value)" 
                class="appearance-none bg-white border border-gray-300 rounded-md pl-3 pr-8 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent cursor-pointer">
          <option value="en" <%= 'selected' if I18n.locale == :en %>><%= t('fiscal_quarter.language.english') %></option>
          <option value="es" <%= 'selected' if I18n.locale == :es %>><%= t('fiscal_quarter.language.spanish') %></option>
        </select>
      </div>
    </div>
    <div class="mt-3 text-center">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 mb-4">
        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
      </div>
      <h3 class="text-lg leading-6 font-medium text-gray-900 mb-2"><%= t('fiscal_quarter.passcode.title') %></h3>
      <p class="text-sm text-gray-500 mb-4"><%= t('fiscal_quarter.passcode.description') %></p>
      
      <form id="passcode-form" class="mt-4">
        <div class="mb-4">
          <input type="password" id="passcode-input" placeholder="<%= t('fiscal_quarter.passcode.placeholder') %>" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
        </div>
        <div id="error-message" class="text-red-600 text-sm mb-4" style="display: none;"></div>
        <div class="flex justify-center space-x-3">
          <button type="button" id="verify-btn" 
                  class="px-4 py-2 bg-blue-600 cursor-pointer text-white text-base font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors">
            <span class="verify-text"><%= t('fiscal_quarter.passcode.verify') %></span>
            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white loading-spinner" style="display: none;" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Main Content -->
<div id="auth-content" class="min-h-screen bg-gray-50 py-8" style="display: none;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Language Selector -->
    <div class="flex justify-end mb-6">
      <div class="relative inline-block">
        <select id="language-selector" onchange="changeLanguage(this.value)" 
                class="appearance-none bg-white border border-gray-300 rounded-md pl-4 pr-10 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent cursor-pointer">
          <option value="en" <%= 'selected' if I18n.locale == :en %>><%= t('fiscal_quarter.language.english') %></option>
          <option value="es" <%= 'selected' if I18n.locale == :es %>><%= t('fiscal_quarter.language.spanish') %></option>
        </select>
      </div>
    </div>
    
    <!-- Confidential Warning -->
    <div class="bg-red-100 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-red-800 font-medium">
            <%= t('fiscal_quarter.warning') %>
          </p>
        </div>
      </div>
    </div>
    
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @fiscal_quarter.name %></h1>
          <p class="text-gray-600 mt-1">
            <%= l(@fiscal_quarter.start_date, format: :fiscal_quarter) %> - 
            <%= l(@fiscal_quarter.end_date, format: :fiscal_quarter) %>
          </p>
        </div>
        <div class="flex items-center space-x-4">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @fiscal_quarter.status == 'active' || @fiscal_quarter.status == 'ready_for_submission' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
            <%= t("fiscal_quarter.status.#{@fiscal_quarter.status}") %>
          </span>
         
        </div>
      </div>
      <% if @fiscal_quarter.notes.present? %>
        <div class="mt-4 p-4 bg-blue-50 rounded-lg">
          <p class="text-blue-800"><%= simple_format(@fiscal_quarter.notes) %></p>
        </div>
      <% end %>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center">
          <div class="p-2 bg-blue-100 rounded-lg">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600"><%= t('fiscal_quarter.summary.invoices') %></p>
            <p class="text-2xl font-bold text-gray-900"><%= @invoices.count %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center">
          <div class="p-2 bg-green-100 rounded-lg">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.25 7.756a4.5 4.5 0 100 8.488M7.5 10.5h5.25m-5.25 3h5.25M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600"><%= t('fiscal_quarter.summary.autonomo_payments') %></p>
            <p class="text-2xl font-bold text-gray-900"><%= @autonomo_payments.count %></p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center">
          <div class="p-2 bg-purple-100 rounded-lg">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600"><%= t('fiscal_quarter.summary.outgoing_receipts') %></p>
            <p class="text-2xl font-bold text-gray-900"><%= @outgoing_receipts.count %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Invoices Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-8">
      <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('fiscal_quarter.sections.invoices') %></h2>
        <% if @invoices.any? && false %>
          <a href="/<%= @fiscal_quarter.identifier %>/invoices/download-all" 
             target="_blank"
             class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M7 13l3 3 7-7"></path>
            </svg>
            <%= t('fiscal_quarter.actions.download_all_zip') %>
          </a>
        <% end %>
      </div>
      <div class="overflow-x-auto">
        <% if @invoices.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.invoice_number') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.recipient') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.amount') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.issued') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.due') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.actions') %></th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @invoices.each do |invoice| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">#<%= invoice.invoice_number %></div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900"><%= invoice.recipient_company_name %></div>
                    <div class="text-sm text-gray-500"><%= invoice.recipient_email %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-semibold text-gray-900">
                      <%= number_to_currency(invoice.total_amount, unit: invoice.currency == 'EUR' ? '€' : '$') %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= invoice.issued_on ? l(invoice.issued_on, format: :table_date) : '-' %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= invoice.due_on ? l(invoice.due_on, format: :table_date) : '-' %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex space-x-2">
                      <a href="/<%= @fiscal_quarter.identifier %>/invoices/<%= invoice.id %>/view.pdf" 
                         target="_blank"
                         class="inline-flex items-center px-2 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        <%= t('fiscal_quarter.actions.view') %>
                      </a>
                      <a href="/<%= @fiscal_quarter.identifier %>/invoices/<%= invoice.id %>/download.pdf" 
                         target="_blank"
                         class="inline-flex items-center px-2 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <%= t('fiscal_quarter.actions.download_pdf') %>
                      </a>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-6 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900"><%= t('fiscal_quarter.empty_states.no_invoices') %></h3>
            <p class="mt-1 text-sm text-gray-500"><%= t('fiscal_quarter.empty_states.no_invoices_desc') %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Autonomo Payments Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('fiscal_quarter.sections.autonomo_payments') %></h2>
      </div>
      <div class="overflow-x-auto">
        <% if @autonomo_payments.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.status') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.uploaded') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.notes') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.actions') %></th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @autonomo_payments.each do |payment| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                      <%= case payment.status
                          when 'paid' then 'bg-green-100 text-green-800'
                          when 'pending' then 'bg-yellow-100 text-yellow-800'
                          when 'rejected' then 'bg-red-100 text-red-800'
                          else 'bg-gray-100 text-gray-800'
                          end %>">
                      <%= t("fiscal_quarter.payment_status.#{payment.status}") %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= payment.uploaded_on ? l(payment.uploaded_on, format: :table_date) : '-' %>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900 max-w-xs truncate">
                      <%= payment.notes.present? ? payment.notes : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if payment.payment_file.attached? %>
                      <div class="flex space-x-2">
                        <a href="/<%= @fiscal_quarter.identifier %>/autonomo-payments/<%= payment.id %>/view" 
                           target="_blank"
                           class="inline-flex items-center px-2 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                          </svg>
                          <%= t('fiscal_quarter.actions.view') %>
                        </a>
                        <a href="/<%= @fiscal_quarter.identifier %>/autonomo-payments/<%= payment.id %>/download" 
                           target="_blank"
                           class="inline-flex items-center px-2 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                          </svg>
                          <%= t('fiscal_quarter.actions.download_pdf') %>
                        </a>
                      </div>
                    <% else %>
                      <span class="text-sm text-gray-400"><%= t('fiscal_quarter.empty_states.no_file') %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-6 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900"><%= t('fiscal_quarter.empty_states.no_autonomo_payments') %></h3>
            <p class="mt-1 text-sm text-gray-500"><%= t('fiscal_quarter.empty_states.no_autonomo_payments_desc') %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Outgoing Receipts Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('fiscal_quarter.sections.outgoing_receipts') %></h2>
      </div>
      <div class="overflow-x-auto">
        <% if @outgoing_receipts.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.status') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.uploaded') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.service') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.notes') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('fiscal_quarter.table_headers.actions') %></th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @outgoing_receipts.each do |receipt| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                      <%= case receipt.status
                          when 'paid' then 'bg-green-100 text-green-800'
                          when 'pending' then 'bg-yellow-100 text-yellow-800'
                          when 'rejected' then 'bg-red-100 text-red-800'
                          else 'bg-gray-100 text-gray-800'
                          end %>">
                      <%= t("fiscal_quarter.payment_status.#{receipt.status}") %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= receipt.uploaded_on ? l(receipt.uploaded_on, format: :table_date) : '-' %>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900 max-w-xs truncate">
                      <%= receipt.service.present? ? receipt.service : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900 max-w-xs truncate">
                      <%= receipt.notes.present? ? receipt.notes : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if receipt.receipt_file.attached? %>
                      <div class="flex space-x-2">
                        <a href="/<%= @fiscal_quarter.identifier %>/outgoing-receipts/<%= receipt.id %>/view" 
                           target="_blank"
                           class="inline-flex items-center px-2 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                          </svg>
                          <%= t('fiscal_quarter.actions.view') %>
                        </a>
                        <a href="/<%= @fiscal_quarter.identifier %>/outgoing-receipts/<%= receipt.id %>/download" 
                           target="_blank"
                           class="inline-flex items-center px-2 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                          </svg>
                          <%= t('fiscal_quarter.actions.download') %>
                        </a>
                      </div>
                    <% else %>
                      <span class="text-sm text-gray-400"><%= t('fiscal_quarter.empty_states.no_file') %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-6 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900"><%= t('fiscal_quarter.empty_states.no_outgoing_receipts') %></h3>
            <p class="mt-1 text-sm text-gray-500"><%= t('fiscal_quarter.empty_states.no_outgoing_receipts_desc') %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const fiscalQuarterId = '<%= @fiscal_quarter.identifier %>';
  const storageKey = `fiscal_quarter_access_${fiscalQuarterId}`;
  const passcodeModal = document.getElementById('passcode-modal');
  const mainContent = document.getElementById('auth-content');
  const passcodeForm = document.getElementById('passcode-form');
  const passcodeInput = document.getElementById('passcode-input');
  const errorMessage = document.getElementById('error-message');
  const verifyBtn = document.getElementById('verify-btn');
  const verifyText = verifyBtn.querySelector('.verify-text');
  const loadingSpinner = verifyBtn.querySelector('.loading-spinner');

  // Translation messages
  const translations = {
    en: {
      required: '<%= I18n.with_locale(:en) { t("fiscal_quarter.passcode.required") } %>',
      invalid: '<%= I18n.with_locale(:en) { t("fiscal_quarter.passcode.invalid") } %>',
      error: '<%= I18n.with_locale(:en) { t("fiscal_quarter.passcode.error") } %>'
    },
    es: {
      required: '<%= I18n.with_locale(:es) { t("fiscal_quarter.passcode.required") } %>',
      invalid: '<%= I18n.with_locale(:es) { t("fiscal_quarter.passcode.invalid") } %>',
      error: '<%= I18n.with_locale(:es) { t("fiscal_quarter.passcode.error") } %>'
    }
  };

  // Get current locale from URL or default to 'en'
  function getCurrentLocale() {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get('locale') || 'en';
  }

  // Get translated message
  function t(key) {
    const locale = getCurrentLocale();
    return translations[locale] && translations[locale][key] ? translations[locale][key] : translations['en'][key];
  }

  // Check if user has access
  function checkAccess() {
    const hasAccess = localStorage.getItem(storageKey);
    if (hasAccess === 'granted') {
      showMainContent();
    } else {
      showPasscodeModal();
    }
  }

  function showMainContent() {
    passcodeModal.style.display = 'none';
    mainContent.style.display = 'block';
  }

  function showPasscodeModal() {
    console.log('Showing passcode modal');
    passcodeModal.style.display = 'block';
    mainContent.style.display = 'none';
    passcodeInput.focus();
  }

  function showError(message) {
    errorMessage.textContent = message;
    errorMessage.style.display = 'block';
    passcodeInput.classList.add('border-red-500');
    // Ensure modal stays visible when showing error
    showPasscodeModal();
  }

  function hideError() {
    errorMessage.style.display = 'none';
    passcodeInput.classList.remove('border-red-500');
  }

  function setLoading(loading) {
    if (loading) {
      verifyBtn.disabled = true;
      verifyText.style.display = 'none';
      loadingSpinner.style.display = 'inline-block';
    } else {
      verifyBtn.disabled = false;
      verifyText.style.display = 'inline';
      loadingSpinner.style.display = 'none';
    }
  }

  // Function to handle passcode verification
  function verifyPasscode() {
    console.log('verifyPasscode function called');
    hideError();
    
    const passcode = passcodeInput.value.trim();
    if (!passcode) {
      showError(t('required'));
      return;
    }

    setLoading(true);

    // Verify passcode with server
    fetch(`/<%= @fiscal_quarter.identifier %>/verify-passcode`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ passcode: passcode })
    })
    .then(response => {
      console.log('Response status:', response.status);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      setLoading(false);
      
      if (data.success) {
        // Store access in localStorage
        localStorage.setItem(storageKey, 'granted');
        showMainContent();
      } else {
        showError(data.error);
        passcodeInput.value = '';
        passcodeInput.focus();
      }
    })
    .catch(error => {
      setLoading(false);
      showError(t('error'));
      console.error('Error:', error);
    });
  }

  // Handle form submission
  passcodeForm.addEventListener('submit', function(e) {
    console.log('Form submit event triggered');
    e.preventDefault();
    e.stopPropagation();
    verifyPasscode();
  });

  // Handle button click
  verifyBtn.addEventListener('click', function(e) {
    console.log('Button click event triggered');
    e.preventDefault();
    e.stopPropagation();
    verifyPasscode();
  });

  // Allow Enter key to submit
  passcodeInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      console.log('Enter key pressed');
      e.preventDefault();
      verifyPasscode();
    }
  });

  // Initialize
  checkAccess();
});

// Language switching function
function changeLanguage(locale) {
  const currentUrl = new URL(window.location);
  currentUrl.searchParams.set('locale', locale);
  window.location.href = currentUrl.toString();
}
</script>
